    <!-- Professors -->
    <string name="professor_oak">Prof. Oak</string>
    <string name="professor_elm">Prof. Elm</string>
    <string name="professor_birch">Prof. Birch</string>
    <string name="professor_rowan">Prof. Rowan</string>
    <string name="professor_juniper">Prof. Juniper</string>
    <string name="professor_gift_received">You received the %1$s!</string>

    <!-- First launch -->
    <string name="color_choice_title">How do you want to see your Pokémon?</string>
    <string name="color_choice_color">In color</string>
    <string name="color_choice_matrix">Black and white, like the Glyph Matrix</string>
    <string name="color_choice_hint">You can change it whenever you like in Settings.</string>

    <!-- Professor Oak's welcome -->
    <string name="oak_intro_1">Hello there! Welcome to the world of Pokémon!</string>
    <string name="oak_intro_2">My name is Oak! People call me the Pokémon Professor!</string>
    <string name="oak_intro_3">This world is inhabited by creatures called Pokémon! For some people, Pokémon are pets. Others use them for battles.</string>
    <string name="oak_intro_4">Myself… I study Pokémon as a profession. And you\'re going to help me!</string>
    <string name="oak_intro_5">Leave your phone face-down and locked. Pokémon will appear on your Glyph Matrix, and you can catch them with a long press.</string>
    <string name="oak_kanto_gift">Take this: your very own Pokédex! It records every Pokémon you register.</string>
    <string name="oak_forgot">Oh! I almost forgot to give you something…</string>
    <string name="oak_intro_6">For now, only Pokémon from Kanto will show up. Keep filling your Pokédex and other professors will want to meet you.</string>
    <string name="oak_intro_7">I\'ve saved my number in your Pokégear. Give me a call and I\'ll tell you about any rumors I hear.</string>
    <string name="oak_intro_8">Your very own Pokémon legend is about to unfold! A world of dreams and adventures with Pokémon awaits! Let\'s go!</string>

    <!-- Regional Pokédexes -->
    <string name="professor_elm_hello">Hi! I\'m Professor Elm, from New Bark Town in Johto. Professor Oak has told me all about you!</string>
    <string name="professor_birch_hello">Hey there! I\'m Professor Birch, from Littleroot Town in Hoenn. I\'d much rather be out in the field than stuck in a lab!</string>
    <string name="professor_rowan_hello">Hmm… So you\'re the trainer Oak keeps talking about. I am Rowan, from Sandgem Town in Sinnoh. I study how Pokémon evolve.</string>
    <string name="professor_juniper_hello">Hello! I\'m Professor Juniper, from Nuvema Town in Unova. I research the origins of Pokémon.</string>
    <string name="professor_pokedex_count">You\'ve already registered %1$d Pokémon. Impressive!</string>
    <string name="professor_pokedex_gift">Take this: the %1$s Pokédex. From now on, Pokémon from %1$s can appear too!</string>
    <string name="professor_number">I\'ve saved my number in your Pokégear. Call me whenever you like!</string>
    <string name="oak_map_1">Ho! You\'ve collected all four regional Pokédexes! You\'re a true researcher.</string>
    <string name="oak_map_2">Take this Town Map. With it, you can choose which regions\' Pokémon appear.</string>
    <string name="oak_charm_1">Incredible! You\'ve registered all %1$d Pokémon. The national Pokédex is complete!</string>
    <string name="oak_charm_2">Take this Shiny Charm. They say it attracts shiny Pokémon.</string>
    <string name="oak_charm_3">From now on, shinies will be three times as common. Keep looking!</string>
    <string name="oak_exp_share_1">So you\'ve made it to Unova! Your Pokémon must be working hard alongside you.</string>
    <string name="oak_exp_share_2">Take this Exp. Share. While it\'s on, every Pokémon in your team earns experience, a little less than the one you\'re training.</string>
    <string name="oak_exp_share_ask">Some trainers prefer to train just one Pokémon at a time. Do you want it switched on?</string>
    <string name="oak_exp_share_on">Yes</string>
    <string name="oak_exp_share_off">No</string>
    <string name="oak_exp_share_3">You can switch it on and off from your Bag. Pick your team from each Pokémon\'s details in the PC.</string>
    <string name="oak_map_3">You\'ll find it in your Bag. Keep up the good work!</string>

    <!-- Key items for legendary Pokémon -->
    <string name="professor_gift_hello">Hello! It\'s %1$s. I\'ve heard something you\'ll want to know…</string>
    <string name="professor_gift_item">Take this: the %1$s. They say %2$s won\'t show up without it.</string>
    <string name="professor_gift_bye">Good luck! Call me if you find anything.</string>

    <!-- Pokégear -->
    <string name="pokegear_title">Pokégear</string>
    <string name="pokegear_call">Call</string>
    <string name="pokegear_has_something">Has something for you!</string>
    <string name="call_hello">Hello? Oh, it\'s you! %1$s here.</string>
    <string name="call_progress">You\'ve registered %1$d of the %2$d Pokémon from %3$s.</string>
    <string name="call_eval_low">There\'s still a lot to discover. Keep that phone face-down!</string>
    <string name="call_eval_mid">You\'re making good progress. Keep it up!</string>
    <string name="call_eval_high">Amazing! You\'re almost there.</string>
    <string name="call_eval_complete">You\'ve completed it! I\'m speechless.</string>
    <string name="call_rumor">By the way, I heard a rumor…</string>
    <string name="call_no_rumor">I haven\'t heard any rumors yet. Grow your Pokédex and I\'m sure something will come up.</string>
    <string name="call_bye">Talk to you later!</string>
    <string name="rumors_region_locked">You need the %1$s Pokédex to hear about this one.</string>

    <!-- Fisherman, clerk and breeder -->
    <string name="npc_fisherman">Fisherman</string>
    <string name="npc_clerk_m">Clerk</string>
    <string name="npc_clerk_f">Clerk</string>
    <string name="npc_breeder_m">Pokémon Breeder</string>
    <string name="npc_breeder_f">Pokémon Breeder</string>
    <string name="npc_fisher_old_1">Hey there! You\'ve caught quite a few Pokémon. Do you like fishing too?</string>
    <string name="npc_fisher_old_2">Take this Old Rod. Use it from your Bag and water Pokémon will bite for a while.</string>
    <string name="npc_fisher_good">You again! You\'re turning into a real angler. This Good Rod hooks better Pokémon.</string>
    <string name="npc_fisher_super">A hundred catches already? Here, my most prized possession: the Super Rod!</string>
    <string name="npc_fisher_bye">Only one rod can be used at a time, so pick the one for the Pokémon you\'re after. Good luck!</string>
    <string name="npc_clerk_1">Welcome! %1$d kinds of Pokémon registered… You must be tired of meeting the same ones again and again.</string>
    <string name="npc_clerk_2">Here, try this Repel, on the house. While it\'s on, Pokémon you already have will stay away.</string>
    <string name="npc_clerk_3">You can switch it on and off from your Bag. Come back anytime!</string>
    <string name="npc_breeder_1">Oh, you have the Johto Pokédex! Then you\'ll want to meet baby Pokémon, like Pichu or Togepi. They only hatch from Eggs.</string>
    <string name="npc_breeder_2">Whenever you catch a Pokémon, you might find an Egg. You can carry up to three.</string>
    <string name="npc_breeder_3">Eggs hatch while your phone stays locked: some take 2 hours, others 5 or 10. You can check on them on the Home screen.</string>
    <string name="npc_breeder_4">When one hatches, the baby appears on your Glyph Matrix. Catch it with a long press! Hatched Pokémon are more likely to be shiny, too.</string>
    <string name="npc_breeder_5">Here, take this Egg to get started. Look after it!</string>
    <string name="npc_egg_received">You received an Egg!</string>

