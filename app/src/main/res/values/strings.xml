    <string name="home_onboarding_title">Welcome, Trainer!</string>
    <string name="home_onboarding_description">To start your adventure, first equip the included Glyph Toy:</string>
    <string name="home_onboarding_step_1">Go to Settings app → Glyph Interface</string>
    <string name="home_onboarding_step_2">Scroll down and tap Glyph Toys</string>
    <string name="home_onboarding_step_3">Tap the ☰ list icon at the top</string>
    <string name="home_onboarding_step_4">Scroll to Glyph Catch and hit +</string>
    <string name="home_onboarding_step_5">Optional: Move Glyph Catch to the top</string>
    <string name="home_onboarding_step_6">Tap the ← back arrow to return</string>
    <string name="home_onboarding_step_7">Tap the ⚙ gear icon at the top</string>
    <string name="home_onboarding_step_8">Enable Always-on Glyph Toys</string>
    <string name="home_onboarding_step_9">Select Glyph Catch for Always-on</string>
    <string name="home_onboarding_step_format">%1$d. %2$s</string>
    <string name="home_onboarding_end_1">Leave your phone face-down and the Glyph Catch clock should appear. If not, cycle using the touch button.</string>
    <string name="home_onboarding_end_2">Wait a few minutes, and you will meet your first Pokémon. Long-press the touch button to catch it. Good luck!</string>
